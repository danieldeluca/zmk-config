#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>

// Each WIN_* layer sits directly above its macOS layer and only overrides the keys
// that differ on the Windows "Belgian (Period)" layout. WIN is switched on automatically
// while Bluetooth profile 2 is selected (CONFIG_ZMK_PROFILE_LAYER in sofle_choc_pro.conf).
#define BASE 0
#define WIN 1
#define LOWER 2
#define WIN_LOWER 3
#define RAISE 4
#define WIN_RAISE 5
#define ADJUST 6
#define BTSEL 7
// New layers go at the end: inserting one renumbers the others, and bindings saved on the
// keyboard (ZMK Studio) are stored by layer number. Otherwise run a settings reset after flashing.
#define RGBSEL 8

// ------------------------------------------------------------------------------------------------------------
// macOS "French" (AZERTY) input source aliases.
// ZMK sends HID key positions; macOS translates them using the selected input source,
// so these map each French character to the key (+ modifiers) that produces it on a Mac.
// If '@' and '<' come out swapped, exchange the FR_AT/FR_HASH and FR_LT/FR_GT definitions
// (macOS swaps the ISO section key depending on the detected keyboard type).
// ------------------------------------------------------------------------------------------------------------

// Letters that differ from QWERTY
#define FR_A      Q
#define FR_Z      W
#define FR_Q      A
#define FR_M      SEMI
#define FR_W      Z

// Number row (unshifted characters, digits require shift)
#define FR_AT     NUBS          // @
#define FR_HASH   LS(NUBS)      // #
#define FR_AMPS   N1            // &
#define FR_EACU   N2            // é
#define FR_DQUO   N3            // "
#define FR_APOS   N4            // '
#define FR_LPAR   N5            // (
#define FR_SECT   N6            // §
#define FR_EGRV   N7            // è
#define FR_EXCL   N8            // !
#define FR_CCED   N9            // ç
#define FR_AGRV   N0            // à
#define FR_RPAR   MINUS         // )
#define FR_DEG    LS(MINUS)     // °
#define FR_MINUS  EQUAL         // -
#define FR_UNDS   LS(EQUAL)     // _

#define FR_N1     LS(N1)
#define FR_N2     LS(N2)
#define FR_N3     LS(N3)
#define FR_N4     LS(N4)
#define FR_N5     LS(N5)
#define FR_N6     LS(N6)
#define FR_N7     LS(N7)
#define FR_N8     LS(N8)
#define FR_N9     LS(N9)
#define FR_N0     LS(N0)

// Punctuation
#define FR_CIRC   LBKT          // ^ (dead key)
#define FR_DLR    RBKT          // $
#define FR_ASTR   LS(RBKT)      // *
#define FR_UGRV   SQT           // ù
#define FR_PERC   LS(SQT)       // %
#define FR_GRV    BSLH          // ` (dead key)
#define FR_PND    LS(BSLH)      // £
#define FR_LT     GRAVE         // <
#define FR_GT     LS(GRAVE)     // >
#define FR_COMMA  M             // ,
#define FR_QUES   LS(M)         // ?
#define FR_SEMI   COMMA         // ;
#define FR_DOT    LS(COMMA)     // .
#define FR_COLON  DOT           // :
#define FR_SLSH   LS(DOT)       // /
#define FR_EQUAL  FSLH          // =
#define FR_PLUS   LS(FSLH)      // +

// Option-layer symbols
#define FR_LBRC   LA(N5)        // {
#define FR_RBRC   LA(MINUS)     // }
#define FR_LBKT   LS(LA(N5))    // [
#define FR_RBKT   LS(LA(MINUS)) // ]
#define FR_PIPE   LS(LA(L))     // |
#define FR_BSLH   LS(LA(DOT))   // backslash
#define FR_TILD   LA(N)         // ~ (dead key)

// macOS editing shortcuts (follow the French letters)
#define FR_UNDO   LG(FR_Z)
#define FR_CUT    LG(X)
#define FR_COPY   LG(C)
#define FR_PASTE  LG(V)

// ------------------------------------------------------------------------------------------------------------
// Windows "Belgian (Period)" (AZERTY) input source aliases, only for characters whose key differs
// from macOS French. AltGr is the right Alt key.
// ------------------------------------------------------------------------------------------------------------

#define BE_LT     NUBS          // <
#define BE_GT     LS(NUBS)      // >
#define BE_PIPE   RA(N1)        // |
#define BE_AT     RA(N2)        // @
#define BE_HASH   RA(N3)        // #
#define BE_LBRC   RA(N9)        // {
#define BE_RBRC   RA(N0)        // }
#define BE_LBKT   RA(LBKT)      // [
#define BE_RBKT   RA(RBKT)      // ]
#define BE_BSLH   RA(NUBS)      // backslash
#define BE_TILD   RA(FSLH)      // ~ (dead key)
#define BE_GRV    RA(BSLH)      // ` (dead key)
#define BE_PND    LS(BSLH)      // £

// Windows editing shortcuts (follow the French letters)
#define BE_UNDO   LC(FR_Z)
#define BE_CUT    LC(X)
#define BE_COPY   LC(C)
#define BE_PASTE  LC(V)

/ {

  behaviors {
    // Left encoder while its push button is held: cycle Bluetooth profiles
    bt_rot: bt_rotate {
      compatible = "zmk,behavior-sensor-rotate";
      #sensor-binding-cells = <0>;
      bindings = <&bt BT_PRV>, <&bt BT_NXT>;
    };

    // Left encoder otherwise: ignore rotation to avoid accidental profile changes
    rot_none: rot_none {
      compatible = "zmk,behavior-sensor-rotate";
      #sensor-binding-cells = <0>;
      bindings = <&none>, <&none>;
    };

    // Windows: same key gives @, shifted # (like the macOS @ # key)
    be_at_hash: be_at_hash {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&kp BE_AT>, <&kp BE_HASH>;
      mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    // Windows: same key gives `, shifted £ (like the macOS ` £ key)
    be_grv_pnd: be_grv_pnd {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&kp BE_GRV>, <&kp BE_PND>;
      mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    // Right encoder while its push button is held: underglow brightness
    rgb_brt: rgb_brightness {
      compatible = "zmk,behavior-sensor-rotate";
      #sensor-binding-cells = <0>;
      bindings = <&rgb_ug RGB_BRD>, <&rgb_ug RGB_BRI>;
    };

    // Right encoder button: tap = mute, hold = RGBSEL layer
    ht_rgb: hold_tap_rgb {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      flavor = "hold-preferred";
      tapping-term-ms = <200>;
      bindings = <&mo>, <&kp>;
    };

    // Right encoder button: single tap/hold as above, double tap = underglow on/off
    td_mute_rgb: tap_dance_mute_rgb {
      compatible = "zmk,behavior-tap-dance";
      #binding-cells = <0>;
      tapping-term-ms = <200>;
      bindings = <&ht_rgb RGBSEL C_MUTE>, <&rgb_ug RGB_TOG>;
    };
  };

  conditional_layers {
    compatible = "zmk,conditional-layers";
    // Activate ADJUST layer by pressing raise and lower
    adjust_layer {
      if-layers = <LOWER RAISE>;
      then-layer = <ADJUST>;
    };
    // Windows variants of LOWER and RAISE while the WIN layer is on
    win_lower_layer {
      if-layers = <LOWER WIN>;
      then-layer = <WIN_LOWER>;
    };
    win_raise_layer {
      if-layers = <RAISE WIN>;
      then-layer = <WIN_RAISE>;
    };
  };

  keymap {
    compatible = "zmk,keymap";

    default_layer {
      display-name = "default";
      // ------------------------------------------------------------------------------------------------------------
      // |  @ #  | & 1 | é 2 | " 3  | ' 4  | ( 5  |                   | § 6  | è 7   | ! 8   | ç 9  |  à 0  |  ) °  |
      // |  ESC  |  A  |  Z  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
      // |  TAB  |  Q  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   M   |  ù %  |
      // | SHIFT |  W  |  X  |  C   |  V   |  B   |  BTSEL |  |MUTE/RGB|  N   |  , ?  |  ; .  |  : / |  = +  | SHIFT |
      //               | GUI | ALT  | CTRL | LOWER|  ENTER |  | SPACE | RAISE| CTRL  | ALT   | - _  |
      bindings = <
        &kp FR_AT &kp FR_AMPS &kp FR_EACU &kp FR_DQUO &kp FR_APOS &kp FR_LPAR                       &kp FR_SECT &kp FR_EGRV  &kp FR_EXCL &kp FR_CCED  &kp FR_AGRV &kp FR_RPAR
        &kp ESC   &kp FR_A    &kp FR_Z    &kp E       &kp R       &kp T                             &kp Y       &kp U        &kp I       &kp O        &kp P       &kp BSPC
        &kp TAB   &kp FR_Q    &kp S       &kp D       &kp F       &kp G                             &kp H       &kp J        &kp K       &kp L        &kp FR_M    &kp FR_UGRV
        &kp LSHFT &kp FR_W    &kp X       &kp C       &kp V       &kp B   &mo BTSEL  &td_mute_rgb   &kp N       &kp FR_COMMA &kp FR_SEMI &kp FR_COLON &kp FR_EQUAL &kp RSHFT
        &kp LGUI &kp LALT &kp LCTRL &mo LOWER  &kp RET    &kp SPACE  &mo RAISE  &kp RCTRL &kp RALT  &kp FR_MINUS
      >;

      sensor-bindings = <&rot_none &inc_dec_kp C_VOL_DN C_VOL_UP>;
    };

    win_layer {
      display-name = "win";
      // Windows Belgian overrides of default: @ # key (left of & 1)
      bindings = <
        &be_at_hash     &trans          &trans          &trans          &trans          &trans               &trans          &trans          &trans          &trans          &trans          &trans
        &trans          &trans          &trans          &trans          &trans          &trans               &trans          &trans          &trans          &trans          &trans          &trans
        &trans          &trans          &trans          &trans          &trans          &trans               &trans          &trans          &trans          &trans          &trans          &trans
        &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans
        &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
      >;
    };

    lower_layer {
      display-name = "lower";
      // ------------------------------------------------------------------------------------------------------------
      // |  ` £  |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
      // |  < >  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |  F12  |
      // |   ~   |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   |   |
      // |       |  =  |  -  |  +   |  {   |  }   |        |  |       |  [   |  ]    |  _    |  °   |   \   |       |
      //               |     |      |      |      |        |  |       |      |       |       |      |
      bindings = <
        &kp FR_GRV  &kp F1       &kp F2       &kp F3      &kp F4      &kp F5                       &kp F6      &kp F7      &kp F8      &kp F9      &kp F10     &kp F11
        &kp FR_LT   &kp FR_N1    &kp FR_N2    &kp FR_N3   &kp FR_N4   &kp FR_N5                    &kp FR_N6   &kp FR_N7   &kp FR_N8   &kp FR_N9   &kp FR_N0   &kp F12
        &kp FR_TILD &kp FR_EXCL  &kp FR_AT    &kp FR_HASH &kp FR_DLR  &kp FR_PERC                  &kp FR_CIRC &kp FR_AMPS &kp FR_ASTR &kp FR_LPAR &kp FR_RPAR &kp FR_PIPE
        &trans      &kp FR_EQUAL &kp FR_MINUS &kp FR_PLUS &kp FR_LBRC &kp FR_RBRC  &trans &trans   &kp FR_LBKT &kp FR_RBKT &kp FR_UNDS &kp FR_DEG  &kp FR_BSLH &trans
        &trans    &trans      &trans    &trans     &trans &trans  &trans    &trans   &trans    &trans
      >;

      sensor-bindings = <&rot_none &inc_dec_kp C_VOL_DN C_VOL_UP>;
    };

    win_lower_layer {
      display-name = "win lower";
      // Windows Belgian overrides of lower: ` £, < >, ~, @, #, |, { }, [ ], backslash
      bindings = <
        &be_grv_pnd     &trans          &trans          &trans          &trans          &trans               &trans          &trans          &trans          &trans          &trans          &trans
        &kp BE_LT       &trans          &trans          &trans          &trans          &trans               &trans          &trans          &trans          &trans          &trans          &trans
        &kp BE_TILD     &trans          &kp BE_AT       &kp BE_HASH     &trans          &trans               &trans          &trans          &trans          &trans          &trans          &kp BE_PIPE
        &trans          &trans          &trans          &trans          &kp BE_LBRC     &kp BE_RBRC     &trans          &trans          &kp BE_LBKT     &kp BE_RBKT     &trans          &trans          &kp BE_BSLH     &trans
        &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
      >;
    };

    raise_layer {
      display-name = "raise";
      // ------------------------------------------------------------------------------------------------------------
      // | BTCLR | BT1  | BT2  |  BT3  |  BT4  |  BT5 |                |      |      |       |      |       |       |
      // |       | INS  | PSCR | GUI   |       |      |                | PGUP |      |   ^   |      |   0   |       |
      // |       | ALT  | CTRL | SHIFT |       | CAPS |                | PGDN |   <- |   v   |  ->  |  DEL  | BKSPC |
      // |       | UNDO | CUT  | COPY  | PASTE |      |      |  |      |      |      |       |      |       |       |
      //                |      |       |       |      |      |  |      |      |      |       |      |
      bindings = <
        &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4                  &trans    &trans    &trans   &trans    &trans    &trans
        &trans     &kp INS      &kp PSCRN    &kp K_CMENU  &trans       &trans                        &kp PG_UP &trans    &kp UP   &trans    &kp FR_N0 &trans
        &trans     &kp LALT     &kp LCTRL    &kp LSHFT    &trans       &kp CLCK                      &kp PG_DN &kp LEFT  &kp DOWN &kp RIGHT &kp DEL   &kp BSPC
        &trans     &kp FR_UNDO  &kp FR_CUT   &kp FR_COPY  &kp FR_PASTE &studio_unlock        &trans  &trans  &trans    &trans    &trans   &trans    &trans    &trans
        &trans       &trans       &trans       &trans        &trans  &trans  &trans    &trans    &trans   &trans
      >;

      sensor-bindings = <&rot_none &inc_dec_kp C_VOL_DN C_VOL_UP>;
    };

    win_raise_layer {
      display-name = "win raise";
      // Windows Belgian overrides of raise: Ctrl instead of Cmd for undo/cut/copy/paste
      bindings = <
        &trans          &trans          &trans          &trans          &trans          &trans               &trans          &trans          &trans          &trans          &trans          &trans
        &trans          &trans          &trans          &trans          &trans          &trans               &trans          &trans          &trans          &trans          &trans          &trans
        &trans          &trans          &trans          &trans          &trans          &trans               &trans          &trans          &trans          &trans          &trans          &trans
        &trans          &kp BE_UNDO     &kp BE_CUT      &kp BE_COPY     &kp BE_PASTE    &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans
        &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
      >;
    };

    adjust_layer {
      // ----------------------------------------------------------------------------------------------------------------------------
      // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
      // | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
      // |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
      // |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
      //                    |         |         |         |         |         | |      |      |      |       |      |
      display-name = "adjust";
      bindings = <
        &bt BT_CLR        &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4                            &none &none &none &none &none &none
        &ext_power EP_TOG &rgb_ug RGB_HUD &rgb_ug RGB_HUI &rgb_ug RGB_SAD &rgb_ug RGB_SAI &rgb_ug RGB_EFF                         &none &none &none &none &none &none
        &none             &rgb_ug RGB_BRD &rgb_ug RGB_BRI &none           &none           &none                                   &none &none &none &none &none &none
        &none             &none           &none           &none           &none           &none            &rgb_ug RGB_TOG &none  &none &none &none &none &none &none
        &none           &none           &none           &none            &none           &none  &none &none &none &none
      >;
    };

    btsel_layer {
      display-name = "bt select";
      // Active while the left encoder button is held: rotate the left encoder to switch Bluetooth profile,
      // release the button to keep the selected profile. The right encoder still controls volume.
      bindings = <
        &trans &trans &trans &trans &trans &trans                      &trans &trans &trans &trans &trans &trans
        &trans &trans &trans &trans &trans &trans                      &trans &trans &trans &trans &trans &trans
        &trans &trans &trans &trans &trans &trans                      &trans &trans &trans &trans &trans &trans
        &trans &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans &trans
        &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
      >;

      sensor-bindings = <&bt_rot &inc_dec_kp C_VOL_DN C_VOL_UP>;
    };

    rgbsel_layer {
      display-name = "light";
      // Active while the right encoder button is held: rotate the right encoder to dim/brighten
      // the underglow. Double-tap the button to switch the underglow on/off.
      bindings = <
        &trans &trans &trans &trans &trans &trans                      &trans &trans &trans &trans &trans &trans
        &trans &trans &trans &trans &trans &trans                      &trans &trans &trans &trans &trans &trans
        &trans &trans &trans &trans &trans &trans                      &trans &trans &trans &trans &trans &trans
        &trans &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans &trans
        &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
      >;

      sensor-bindings = <&rot_none &rgb_brt>;
    };
  };
};
